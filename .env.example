# ==============================================================================
# StaleByte Assistant Configuration Template
# Copy this file to .env and set your credentials
# ==============================================================================

# 1. Interactive Assistant API Key
# Used specifically for the interactive chat widget and on-demand "Explain this" buttons.
# Uses Meta Muse Spark 1.3 via an OpenAI-compatible chat completions endpoint.
MUSE_SPARK_API_KEY=your_interactive_chat_api_key_here

# 2. Automatic Result Summary API Key
# Used specifically for generating automatic plain-language summaries on core result routes
# (check, build, run/normal, run/collision, run/skew, upload-check).
# Keeps quotas and rate limits isolated between background route execution and interactive user chats.
# Both keys target the same muse-spark-1.3 model.
SUMMARY_API_KEY=your_summary_api_key_here

# API Base URL (OpenAI-compatible)
META_API_BASE_URL=https://api.meta.ai/v1

# Target Model Identifier
META_MODEL_ID=muse-spark-1.3
