# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
stalebyte.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.impeccable/


# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Generated Cache Files (keep directory tracked via .gitkeep)
cache/*.json
!cache/.gitkeep
cache/uploads/*
!cache/uploads/.gitkeep
